DATABASE_URL=postgres://squadup:squadup@localhost:5432/squadup?sslmode=disable
JWT_SECRET=SQUADUP
PORT=8080
IMAGE_GENERATION_URL=https://your-image-generation-api.workers.dev
IMAGE_GENERATION_API_KEY=your_image_generation_api_key_here

# Backblaze B2 Storage (S3-Compatible API)
# Region endpoint format: https://s3.<region>.backblazeb2.com (e.g. us-east-005, us-west-004)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_b2_bucket_name
# Optional custom/CDN domain or direct public URL. Defaults to https://<bucket>.s3.<region>.backblazeb2.com
B2_PUBLIC_URL=https://your-bucket-name.s3.us-east-005.backblazeb2.com
